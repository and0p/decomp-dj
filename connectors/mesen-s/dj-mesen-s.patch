+#include "DjConnector.h"
+#endif
 
 #ifndef DUMMYCPU
 Cpu::Cpu(Console *console)
@@ -15,6 +18,11 @@ Cpu::Cpu(Console *console)
 	_console = console;
 	_memoryManager = console->GetMemoryManager().get();
 	_dmaController = console->GetDmaController().get();
+#ifdef DECOMP_DJ
+	// dj_read_registers reads through this, also before anything has run (a frontend that
+	// loads a state first).
+	DjConnector::Regs = &_state;
+#endif
 }
 #endif
 
@@ -104,7 +112,18 @@ uint8_t Cpu::Read(uint32_t addr, MemoryOperationType type)
 {
 	_memoryManager->SetCpuSpeed(_memoryManager->GetCpuSpeed(addr));
 	ProcessCpuCycle();
+#ifdef DECOMP_DJ
+	if(DjConnector::Active && (type == MemoryOperationType::ExecOpCode || type == MemoryOperationType::ExecOperand)) {
+		DjConnector::Regs = &_state;
+		DjConnector::OnExec(_console, _memoryManager, addr, type == MemoryOperationType::ExecOpCode, _state.PS, _state.EmulationMode);
+	}
+#endif
 	uint8_t value = _memoryManager->Read(addr, type);
+#ifdef DECOMP_DJ
+	if(DjConnector::TraceOn) {
+		DjConnector::OnTrace(_memoryManager, (int)type, addr, value, &_state);
+	}
+#endif
 	UpdateIrqNmiFlags();
 	return value;
 }
@@ -113,6 +132,11 @@ void Cpu::Write(uint32_t addr, uint8_t value, MemoryOperationType type)
 {
 	_memoryManager->SetCpuSpeed(_memoryManager->GetCpuSpeed(addr));
 	ProcessCpuCycle();
+#ifdef DECOMP_DJ
+	if(DjConnector::TraceOn) {
+		DjConnector::OnTrace(_memoryManager, (int)type, addr, value, &_state);
+	}
+#endif
 	_memoryManager->Write(addr, value, type);
 	UpdateIrqNmiFlags();
 }
