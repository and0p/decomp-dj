   if (UNLIKELY(cpu_hook))
     cpu_hook(HOOK_M68K_R, 4, address, val);
 #endif
+  DJ_M68K_ACCESS(2, 4, address, val); /* decomp-dj */
 
   return val;
 }
@@ -923,6 +940,7 @@ INLINE void m68ki_write_8(uint address, uint value)
   if (UNLIKELY(cpu_hook))
     cpu_hook(HOOK_M68K_W, 1, address, value);
 #endif
+  DJ_M68K_ACCESS(3, 1, address, value); /* decomp-dj */
 
   temp = &m68ki_cpu.memory_map[((address)>>16)&0xff];
   if (temp->write8) (*temp->write8)(ADDRESS_68K(address),value);
@@ -940,6 +958,7 @@ INLINE void m68ki_write_16(uint address, uint value)
   if (UNLIKELY(cpu_hook))
     cpu_hook(HOOK_M68K_W, 2, address, value);
 #endif
+  DJ_M68K_ACCESS(3, 2, address, value); /* decomp-dj */
 
   temp = &m68ki_cpu.memory_map[((address)>>16)&0xff];
   if (temp->write16) (*temp->write16)(ADDRESS_68K(address),value);
@@ -957,6 +976,7 @@ INLINE void m68ki_write_32(uint address, uint value)
   if (UNLIKELY(cpu_hook))
     cpu_hook(HOOK_M68K_W, 4, address, value);
 #endif
+  DJ_M68K_ACCESS(3, 4, address, value); /* decomp-dj */
 
