+/* decomp-dj: the connector's hooks (m68k.h), for the main 68000 only (m68kcpu.c defines
+ * DJ_MAIN_68K; the Mega CD's sub-CPU, s68kcpu.c, builds this file without it). */
+#ifdef DJ_MAIN_68K
+#define DJ_M68K_FETCH(pc, len) do { if (UNLIKELY(dj_m68k_fetch != NULL)) dj_m68k_fetch((pc), (len)); } while (0)
+#define DJ_M68K_ACCESS(kind, width, address, value) do { if (UNLIKELY(dj_m68k_access != NULL)) dj_m68k_access((kind), (width), (address), (value)); } while (0)
+#else
+#define DJ_M68K_FETCH(pc, len) do { } while (0)
+#define DJ_M68K_ACCESS(kind, width, address, value) do { } while (0)
+#endif
+
 /* ---------------------------- Read Immediate ---------------------------- */
 
 /* Handles all immediate reads, does address error check, function code setting,
@@ -795,6 +805,7 @@ INLINE uint m68ki_read_imm_16(void)
     CPU_PREF_DATA = m68k_read_immediate_16(REG_PC);
   }
   temp_val = CPU_PREF_DATA;
+  DJ_M68K_FETCH(REG_PC, 2); /* decomp-dj */
   REG_PC += 2;
   CPU_PREF_ADDR = REG_PC;
   CPU_PREF_DATA = m68k_read_immediate_16(REG_PC);
@@ -806,6 +817,7 @@ INLINE uint m68ki_read_imm_16(void)
   m68ki_check_address_error(REG_PC, MODE_READ, FLAG_S | FUNCTION_CODE_USER_PROGRAM) /* auto-disable (see m68kcpu.h) */
 #endif
   REG_PC += 2;
+  DJ_M68K_FETCH(pc, 2); /* decomp-dj */
   return m68k_read_immediate_16(pc);
 #endif /* M68K_EMULATE_PREFETCH */
 }
@@ -824,6 +836,7 @@ INLINE uint m68ki_read_imm_32(void)
     CPU_PREF_DATA = m68k_read_immediate_16(REG_PC);
   }
   temp_val = CPU_PREF_DATA;
+  DJ_M68K_FETCH(REG_PC, 4); /* decomp-dj */
   REG_PC += 2;
   temp_val = (temp_val << 16) | m68k_read_immediate_16(REG_PC);
   REG_PC += 2;
@@ -837,6 +850,7 @@ INLINE uint m68ki_read_imm_32(void)
   m68ki_check_address_error(REG_PC, MODE_READ, FLAG_S | FUNCTION_CODE_USER_PROGRAM) /* auto-disable (see m68kcpu.h) */
 #endif
   REG_PC += 4;
+  DJ_M68K_FETCH(pc, 4); /* decomp-dj */
