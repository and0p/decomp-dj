diff --git a/include/mgba/internal/arm/arm.h b/include/mgba/internal/arm/arm.h
index 5ef2da965..895013d2f 100644
--- a/include/mgba/internal/arm/arm.h
+++ b/include/mgba/internal/arm/arm.h
@@ -209,6 +209,9 @@ void ARMRaiseSWI(struct ARMCore*);
 void ARMRaiseUndefined(struct ARMCore*);
 
 void ARMRun(struct ARMCore* cpu);
+/* decomp-dj: called for every instruction the CPU reaches (before its condition is checked),
+ * with its address, its opcode and whether it's Thumb. NULL when dj isn't driving the core. */
+extern void (*ARMDjExecHook)(uint32_t address, uint32_t opcode, bool thumb);
 void ARMRunLoop(struct ARMCore* cpu);
 void ARMRunFake(struct ARMCore* cpu, uint32_t opcode);
 
diff --git a/src/arm/arm.c b/src/arm/arm.c
index 0b92d7f55..212cd535c 100644
--- a/src/arm/arm.c
+++ b/src/arm/arm.c
@@ -198,10 +198,15 @@ static const uint16_t conditionLut[16] = {
 	0x0000 // NV
 };
 
+void (*ARMDjExecHook)(uint32_t address, uint32_t opcode, bool thumb) = NULL;
+
 static inline void ARMStep(struct ARMCore* cpu) {
 	uint32_t opcode = cpu->prefetch[0];
 	cpu->prefetch[0] = cpu->prefetch[1];
 	cpu->gprs[ARM_PC] += WORD_SIZE_ARM;
+	if (ARMDjExecHook) {
+		ARMDjExecHook(cpu->gprs[ARM_PC] - 2 * WORD_SIZE_ARM, opcode, false);
+	}
 	LOAD_32(cpu->prefetch[1], cpu->gprs[ARM_PC] & cpu->memory.activeMask, cpu->memory.activeRegion);
 
 	unsigned condition = opcode >> 28;
@@ -221,6 +226,9 @@ static inline void ThumbStep(struct ARMCore* cpu) {
 	uint32_t opcode = cpu->prefetch[0];
 	cpu->prefetch[0] = cpu->prefetch[1];
 	cpu->gprs[ARM_PC] += WORD_SIZE_THUMB;
+	if (ARMDjExecHook) {
+		ARMDjExecHook(cpu->gprs[ARM_PC] - 2 * WORD_SIZE_THUMB, opcode, true);
+	}
 	LOAD_16(cpu->prefetch[1], cpu->gprs[ARM_PC] & cpu->memory.activeMask, cpu->memory.activeRegion);
 	ThumbInstruction instruction = _thumbTable[opcode >> 6];
 	instruction(cpu, opcode);
