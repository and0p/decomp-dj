@@ -406,6 +406,14 @@ extern void s68k_clear_wait(void);
 extern unsigned int m68k_get_reg(m68k_register_t reg);
 extern unsigned int s68k_get_reg(m68k_register_t reg);
 
+/* decomp-dj: hooks on the main 68000, NULL unless dj is driving the core (dj_connector.c).
+ * exec: an instruction at pc is about to be fetched and run. fetch: the CPU read len bytes of
+ * the instruction stream at pc (its opcode word, then its extension words). access: a data
+ * read (kind 2) or write (kind 3) of width bytes. */
+extern void (*dj_m68k_exec)(unsigned int pc);
+extern void (*dj_m68k_fetch)(unsigned int pc, unsigned int len);
+extern void (*dj_m68k_access)(int kind, int width, unsigned int address, unsigned int value);
+
 /* Poke values into the internals of the currently running CPU context */
 extern void m68k_set_reg(m68k_register_t reg, unsigned int value);
 extern void s68k_set_reg(m68k_register_t reg, unsigned int value);
