    return true;
 }
 
@@ -2277,8 +2342,25 @@ void retro_cheat_set(unsigned index, bool enabled, const char* codeLine)
     cheat_set_enabled(&g_cheat_ctx, name, enabled);
 }
 
+#ifdef DECOMP_DJ
+/* The job runs inside gen_interrupt: a save right after the vertical interrupt that ended
+ * the frame, a load at the next interrupt. Return to the frontend now, at that frame
+ * boundary, instead of running on to the next vertical interrupt; the next retro_run
+ * resumes here and runs exactly one frame. Not from n64StateCallback: the core calls it
+ * before it clears the job (and twice for a save), so a job set meanwhile would be lost. */
+void dj_state_job_done(void)
+{
+    if (dj_state_job_pending && retro_savestate_complete)
+       co_switch(retro_thread);
+}
+#endif
+
 void retro_return(void)
 {
+#ifdef DECOMP_DJ
+    if (dj_state_job_pending)
+       dj_state_job_frames++;
+#endif
     if(!(current_rdp_type == RDP_PLUGIN_GLIDEN64 && EnableThreadedRenderer))
     {
        co_switch(retro_thread);
