@@ -2198,6 +2254,15 @@ bool retro_unserialize(const void *data, size_t size)
       glsm_ctl(GLSM_CTL_STATE_UNBIND, NULL);
    }
 
+#ifdef DECOMP_DJ
+   dj_state_job_pending = false;
+   if (dj_active && dj_state_job_frames > 0)
+   {
+      /* Frames ran before the load: what follows isn't the frame after the saved one. */
+      log_cb(RETRO_LOG_WARN, "decomp-dj: the state was loaded %u frame(s) late\n", dj_state_job_frames);
+      return false;
